{
  "name": "@wisdom/control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/cli/migrate.ts",
    "consent:seed": "tsx src/cli/consent-seed.ts",
    "consent:activate": "tsx src/cli/consent-activate.ts",
    "retention:purge": "tsx src/cli/purge.ts",
    "notifications:worker": "tsx src/notification-worker.ts",
    "content:worker": "tsx src/content-worker.ts",
    "admin:bootstrap": "tsx src/admin/cli.ts bootstrap",
    "admin:password-reset": "tsx src/admin/cli.ts password-reset",
    "admin:mfa-replace": "tsx src/admin/cli.ts mfa-replace"
  },
  "dependencies": {
    "@hono/node-server": "2.0.9",
    "@wisdom/shared": "0.1.0",
    "argon2": "0.44.0",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.30",
    "nodemailer": "9.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
