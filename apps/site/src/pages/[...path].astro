---
import PublishedArticle from "../components/PublishedArticle.astro";
import PublicPage from "../components/PublicPage.astro";
import { createPublicStaticPaths, type PublicStaticPathProps } from "../lib/static-paths.js";
import { createSearchBuildState } from "../search/build.js";

export function getStaticPaths() {
  const state = createSearchBuildState();
  return createPublicStaticPaths(state.content, state.index);
}

type Props = PublicStaticPathProps;
const props = Astro.props;
---

{props.kind === "base" ? (
  <PublicPage
    locale={props.locale}
    route={props.route}
    articles={props.articles}
    searchDocument={props.searchDocument}
  />
) : (
  <PublishedArticle
    article={props.article}
    localeLinks={props.localeLinks}
    xDefaultHref={props.xDefaultHref}
    searchDocument={props.searchDocument}
  />
)}
