---
import type { Locale } from "@wisdom/shared";

import PublicPage from "../components/PublicPage.astro";
import { PUBLIC_ROUTE_ENTRIES, type PublicRoute } from "../lib/routes.js";

export function getStaticPaths() {
  return PUBLIC_ROUTE_ENTRIES
    .filter(({ pathname }) => pathname !== "/404")
    .map(({ locale, route, pathname }) => ({
      params: { path: pathname === "/" ? undefined : pathname.slice(1) },
      props: { locale, route },
    }));
}

interface Props {
  locale: Locale;
  route: PublicRoute;
}

const { locale, route } = Astro.props;
---

<PublicPage locale={locale} route={route} />
