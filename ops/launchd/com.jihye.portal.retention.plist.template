<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.jihye.portal.retention</string>
  <key>ProgramArguments</key><array>
    <string>{{NODE_BINARY}}</string><string>{{CURRENT_RELEASE}}/ops/scripts/retention.mjs</string>
    <string>--database</string><string>{{DATA_ROOT}}/portal.sqlite</string>
    <string>--</string>
    <string>{{NODE_BINARY}}</string><string>{{CURRENT_RELEASE}}/ops/scripts/keychain-exec.mjs</string>
    <string>--account</string><string>{{USER_NAME}}</string>
    <string>--config</string><string>{{APP_ROOT}}/shared/runtime.env</string>
    <string>--secret</string><string>ADMIN_SESSION_SECRET=com.jihye.portal.admin-session</string>
    <string>--secret</string><string>CONTROL_HMAC_SECRET=com.jihye.portal.control-hmac</string>
    <string>--secret</string><string>HERMES_HMAC_SECRET=com.jihye.portal.hermes-hmac</string>
    <string>--secret</string><string>PII_ENCRYPTION_KEY=com.jihye.portal.pii-key</string>
    <string>--secret</string><string>WITHDRAWAL_TOKEN_SECRET=com.jihye.portal.withdrawal-token</string>
    <string>--</string><string>{{NODE_BINARY}}</string><string>{{CURRENT_RELEASE}}/apps/control/dist/cli/purge.js</string>
    <string>--apply</string><string>--batch-size</string><string>1000</string>
    <string>--max-batches</string><string>10</string>
  </array>
  <key>WorkingDirectory</key><string>{{CURRENT_RELEASE}}</string>
  <key>Umask</key><integer>63</integer>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>3600</integer>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>{{LOG_ROOT}}/retention.stdout.log</string>
  <key>StandardErrorPath</key><string>{{LOG_ROOT}}/retention.stderr.log</string>
</dict></plist>
