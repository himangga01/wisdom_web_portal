# Non-secret runtime configuration. Render this outside immutable releases with mode 0600.
NODE_ENV=production
DATABASE_PATH={{DATA_ROOT}}/portal.sqlite
# Anonymous visit-statistics rollups. Excluded from encrypted backups because
# it holds no personal data and its loss does not affect consultations — but the
# aggregates cannot be rebuilt, so a disk failure loses the visit history for
# good. Defaults to analytics.db beside DATABASE_PATH when unset.
ANALYTICS_DATABASE_PATH={{DATA_ROOT}}/analytics.db
CONTROL_HOST=127.0.0.1
CONTROL_PORT={{CONTROL_PORT}}
PUBLIC_ORIGIN=https://{{PUBLIC_HOST}}
ADMIN_ORIGIN=https://{{ADMIN_HOST}}
PUBLIC_RELEASE_ROOT={{PUBLIC_RELEASE_ROOT}}
PUBLIC_CURRENT_LINK={{PUBLIC_CURRENT_RELEASE}}
SITE_SOURCE_ROOT={{CURRENT_RELEASE}}
NODE_BINARY={{NODE_BINARY}}
NPM_BINARY={{NPM_BINARY}}
PUBLICATION_BUILD_TIMEOUT_MS=300000
# Optional Naver ownership verification. Replace and uncomment exactly one line.
# NAVER_SITE_VERIFICATION_META=your-token-here
# NAVER_SITE_VERIFICATION_FILE=naver-site-verification.html
PII_ACTIVE_KEY_ID=pii-v1
HERMES_ENDPOINT=http://127.0.0.1:8788/notify
EMAIL_PAYLOAD_MODE=receipt-only
ADMIN_DUMMY_PASSWORD_HASH={{ADMIN_DUMMY_PASSWORD_HASH}}
CODEX_BINARY={{CODEX_BINARY}}
GIT_BINARY={{GIT_BINARY}}
CODEX_MODEL={{CODEX_MODEL}}
CODEX_TEMP_ROOT={{CODEX_TEMP_ROOT}}
CODEX_HOME={{CODEX_HOME}}
CODEX_KEYCHAIN_SERVICE={{CODEX_KEYCHAIN_SERVICE}}
CODEX_TIMEOUT_MS=120000
INDEXNOW_KEYCHAIN_SERVICE={{INDEXNOW_KEYCHAIN_SERVICE}}
INDEXNOW_KEY_LOCATION=https://{{PUBLIC_HOST}}/indexnow-key.txt
INDEXNOW_TIMEOUT_MS=10000
