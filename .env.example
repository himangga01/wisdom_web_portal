# Runtime
NODE_ENV=development
DATABASE_PATH=./data/wisdom.sqlite

# Replace every placeholder with an independent value of at least 32 characters.
ADMIN_SESSION_SECRET=
PII_ENCRYPTION_KEY=
CONTROL_HMAC_SECRET=
WITHDRAWAL_TOKEN_SECRET=
HERMES_HMAC_SECRET=

# Public/admin must be exact, distinct origins. Production requires HTTPS and distinct hostnames.
PUBLIC_ORIGIN=https://www.example.com
ADMIN_ORIGIN=https://admin.example.com

# Public, frozen-policy Argon2id verifier used to equalize unknown-account login work.
ADMIN_DUMMY_PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$BwcHBwcHBwcHBwcHBwcHBw$+PoSSRtbM306Z90yryZta7Qvu3hikTDby6TmJumCJEY

# Versioned PII keyring and loopback control service.
PII_ACTIVE_KEY_ID=pii-v1
PII_PREVIOUS_KEYS_JSON={}
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8787
HERMES_ENDPOINT=http://127.0.0.1:8788/notify

# Safe default. Use full-inquiry only after the production gate is explicitly approved.
EMAIL_PAYLOAD_MODE=receipt-only
