# Runtime
NODE_ENV=development
DATABASE_PATH=./data/wisdom.sqlite

# Replace every placeholder with an independent value of at least 32 characters.
ADMIN_SESSION_SECRET=
PII_ENCRYPTION_KEY=
CONTROL_HMAC_SECRET=
WITHDRAWAL_TOKEN_SECRET=

# Versioned PII keyring and loopback control service.
PII_ACTIVE_KEY_ID=pii-v1
PII_PREVIOUS_KEYS_JSON={}
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8787
PUBLIC_ORIGINS=https://www.example.com

# Safe default. Use full-inquiry only after the production gate is explicitly approved.
EMAIL_PAYLOAD_MODE=receipt-only
